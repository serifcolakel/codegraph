{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["node", "/absolute/path/to/codegraph/dist/cli/index.js", "mcp"],
      "environment": {
        "CODEGRAPH_DB_PATH": "/absolute/path/to/codegraph/.codegraph.sqlite"
      },
      "enabled": true
    }
  }
}
