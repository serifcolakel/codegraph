{
  "name": "codegraph",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "codegraph": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "codegraph": "node dist/cli/index.js",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "dependencies": {
    "@effect/cli": "0.77.2",
    "@effect/platform": "0.97.4",
    "@effect/platform-node": "0.108.4",
    "@effect/sql": "0.52.2",
    "@effect/sql-sqlite-node": "0.54.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "effect": "3.22.5",
    "ignore": "^7.0.5",
    "tree-sitter": "^0.21.1",
    "tree-sitter-c-sharp": "^0.21.3",
    "tree-sitter-go": "^0.23.4",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-rust": "^0.21.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@effect/vitest": "0.30.1",
    "@playwright/test": "1.65.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.9",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}
